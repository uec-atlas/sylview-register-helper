{
  "name": "sylview-register-helper",
  "description": "A helper extension for Sylview",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "codegen": "graphql-codegen",
    "dev": "pnpm codegen && wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm codegen && wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "lint": "biome check --write",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@tailwindcss/vite": "^4.1.18",
    "@urql/exchange-graphcache": "^8.1.0",
    "@urql/vue": "^2.0.0",
    "@vueuse/core": "^13.9.0",
    "primevue": "^4.5.4",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@wxt-dev/module-vue": "^1.0.2",
    "graphql": "^16.12.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^29.2.0",
    "vue-tsc": "^3.2.4",
    "wxt": "^0.20.13"
  }
}
